# ============================================================================
#  MyTDFRIK — variables d'environnement de PRODUCTION (VPS + Traefik)
# ----------------------------------------------------------------------------
#  Copier ce fichier en `docker/.env.prod` sur le VPS, puis renseigner chaque
#  valeur. Ce fichier ne doit JAMAIS être commité (déjà couvert par .gitignore).
#
#      cp docker/.env.prod.example docker/.env.prod
#      chmod 600 docker/.env.prod
#
#  Il sert à la fois à l'interpolation du docker-compose.prod.yml (domaines,
#  mots de passe) et à l'injection des variables applicatives dans l'API.
# ============================================================================

# ========== Domaines (obligatoires) ==========
# Les deux sous-domaines doivent pointer (enregistrement A/AAAA) sur l'IP du VPS
# AVANT le premier démarrage, sinon Let's Encrypt échoue.
WEB_DOMAIN=support.techdifrik.com
API_DOMAIN=api.techdifrik.com

# ========== Traefik mutualisé ==========
# Cette pile ne démarre pas Traefik : elle se greffe sur celui déjà présent sur
# le VPS. Ces valeurs correspondent à sa configuration actuelle — les modifier
# n'a de sens que si le reverse proxy du serveur change.
#   docker inspect traefik --format '{{range .Config.Cmd}}{{println .}}{{end}}'
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_ENTRYPOINT_HTTP=web
TRAEFIK_ENTRYPOINT_HTTPS=websecure

# ========== Images Docker ==========
# Par défaut, les images sont construites sur le VPS (`--build`).
# Pour consommer celles publiées par la CI sur GHCR, décommenter :
# API_IMAGE=ghcr.io/hubersondev/mytdfrik/api:latest
# WEB_IMAGE=ghcr.io/hubersondev/mytdfrik/web:latest

# ========== PostgreSQL (conteneur local) ==========
POSTGRES_USER=mytdfrik
# Générer : openssl rand -hex 24
# IMPORTANT — n'utiliser que [A-Za-z0-9._~-]. Ce mot de passe est injecté dans
# une URL de connexion : un « % », « @ », « / » ou « : » fait échouer l'analyse
# côté TypeORM (« URI malformed »). Proscrire `openssl rand -base64`.
# Le mot de passe est figé au premier démarrage du conteneur : le changer impose
# de supprimer le volume de données correspondant.
POSTGRES_PASSWORD=CHANGE_ME_mot_de_passe_postgres
POSTGRES_DB=mytdfrik

# Base managée externe (Scaleway, Neon…) : décommenter et commenter le service
# `postgres` du compose. Laisser vide sinon — une valeur ici écrase la BD locale.
# DATABASE_URL=postgresql://user:password@hote-externe:5432/mytdfrik?sslmode=require

# ========== Redis (conteneur local) ==========
# Générer : openssl rand -hex 24
# IMPORTANT — n'utiliser que [A-Za-z0-9._~-]. Ce mot de passe est injecté dans
# une URL de connexion : un « % », « @ », « / » ou « : » fait échouer l'analyse
# côté TypeORM (« URI malformed »). Proscrire `openssl rand -base64`.
# Le mot de passe est figé au premier démarrage du conteneur : le changer impose
# de supprimer le volume de données correspondant.
REDIS_PASSWORD=CHANGE_ME_mot_de_passe_redis
# Redis managé externe : décommenter (sinon laisser vide).
# REDIS_URL=rediss://default:password@hote-externe:6379

# ========== Application ==========
LOG_LEVEL=info

# ========== JWT (obligatoire, min. 32 caractères) ==========
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_secret_aleatoire_de_64_octets_minimum_32_caracteres
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ========== Politique de sécurité des comptes ==========
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_DURATION_SECONDS=900
AUTH_LOCK_WINDOW_SECONDS=900
PASSWORD_RESET_TTL_SECONDS=1800
ACCOUNT_ACTIVATION_TTL_SECONDS=259200
BCRYPT_COST=12

# ========== Email transactionnel ==========
# Priorité du transport : SMTP (si SMTP_HOST défini) > Resend > log seulement.
# En production, l'un des deux DOIT être configuré, sinon aucun courriel n'est
# envoyé (activation de compte, réinitialisation de mot de passe…).
#
# -- Option A : Resend (retenu) --
# ATTENTION : SMTP est prioritaire dans le code. Laisser SMTP_HOST vide ou
# commenté, sinon la clé Resend ne sera jamais utilisée.
# Prérequis, dans cet ordre :
#   1. ajouter techdifrik.com dans Resend (Domains > Add Domain) ;
#   2. créer chez Hostinger les enregistrements affichés par Resend — ils
#      portent tous sur le sous-domaine `send` et sur `*._domainkey`, donc le
#      SPF racine de Zoho (v=spf1 include:zohomail.com ~all) reste intact et la
#      réception des courriels n'est pas affectée ;
#   3. attendre le statut « Verified », puis générer une clé API (Sending access).
# MAIL_FROM_ADDRESS doit appartenir au domaine vérifié. La clé de test
# onboarding@resend.dev ne livre qu'à l'adresse du compte Resend.
RESEND_API_KEY=CHANGE_ME_cle_api_resend

# -- Option B : SMTP Zoho (repli) --
# Le domaine est déjà authentifié chez Zoho. Pour basculer : renseigner ces
# quatre variables — SMTP prend alors automatiquement le pas sur Resend.
# Prérequis : une vraie boîte no-reply@techdifrik.com (un alias est refusé),
# l'accès SMTP activé, et un mot de passe d'application si la double
# authentification est active. MAIL_FROM_ADDRESS doit être identique à
# SMTP_USER, sinon Zoho renvoie « 553 Relaying disallowed ».
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_USER=no-reply@techdifrik.com
# SMTP_PASSWORD=

MAIL_FROM_ADDRESS=no-reply@techdifrik.com
MAIL_FROM_NAME=MyTDFRIK · TECHDIFRIK

# ========== Pièces jointes & stockage ==========
# local : volume Docker `api_storage` (sauvegarde à prévoir).
# s3    : Scaleway Object Storage (driver non câblé à ce jour, cf. CDC §11.4).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# S3_BUCKET=
# S3_REGION=fr-par
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
ATTACHMENT_MAX_FILE_BYTES=26214400
ATTACHMENT_MAX_REQUEST_BYTES=104857600
ATTACHMENT_DOWNLOAD_TTL_SECONDS=300
ANTIVIRUS_SIMULATED_DELAY_MS=1500

# ========== Métier ==========
RESOLUTION_VALIDATION_EXPIRY_DAYS=7

# ========== Supervision (optionnel) ==========
# SENTRY_DSN=

# ========== Bootstrap du premier administrateur ==========
# Utilisé uniquement par `scripts/deploy.sh --seed` (premier déploiement).
# Changer le mot de passe dès la première connexion.
ADMIN_BOOTSTRAP_EMAIL=admin@techdifrik.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_mot_de_passe_admin_initial
ADMIN_BOOTSTRAP_FIRST_NAME=Admin
ADMIN_BOOTSTRAP_LAST_NAME=TECHDIFRIK
